# Server-side GitHub API token (fine-grained token with public read access; optional but recommended).
# Set as a Render secret/environment variable, never expose it to the frontend.
GITHUB_TOKEN=

# Hosted Gemma 4 API. Keep this key private and never use a NEXT_PUBLIC_ prefix.
PATCHTRACE_AI_PROVIDER=gemma_api
GEMINI_API_KEY=
GEMMA_API_MODEL=gemma-4-26b-a4b-it
GEMMA_API_TIMEOUT_SECONDS=50

# Set true only for the publicly hosted deployment. Public mode disables local paths and arbitrary pytest execution.
PATCHTRACE_PUBLIC_MODE=false
PATCHTRACE_MAX_REQUESTS_PER_MINUTE=8
PATCHTRACE_MAX_SESSIONS=20
PATCHTRACE_MAX_FILES=500
PATCHTRACE_MAX_FILE_BYTES=600000
PATCHTRACE_CHECK_TIMEOUT_SECONDS=25
PATCHTRACE_CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000

# Optional alternative for local development only:
# PATCHTRACE_AI_PROVIDER=ollama
# PATCHTRACE_OLLAMA_URL=http://localhost:11434
# PATCHTRACE_OLLAMA_MODEL=gemma4:e4b
